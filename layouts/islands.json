{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "sidebar-chrome"
          },
          "size": {
            "px": 38
          },
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 14,
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "space-list"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agent-list"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            }
          ],
          "gap": 12
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "sidebar-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 72
          },
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 14
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "gap": 12,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tab-bar"
          },
          "size": {
            "px": 38
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-header"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 14,
                  "gap": 12,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "file-browser"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "git-changes"
                      }
                    },
                    {
                      "id": "mods",
                      "type": "block",
                      "content": {
                        "mod": "mod-manager"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 12
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "status-bar"
          },
          "size": {
            "px": 32
          },
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 14
        }
      ],
      "gap": 12,
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/islands-grid.png",
    "fit": "cover"
  },
  "padding": 12,
  "terminal_padding": [
    16,
    14
  ],
  "terminal_opacity": 0,
  "gap": 12,
  "floating": [
    {
      "id": "radar",
      "content": {
        "mod": "agent-radar"
      },
      "edge": "right",
      "align": "center",
      "peek": 30
    }
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/islands.svg"
}